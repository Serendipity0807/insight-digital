<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.insight</groupId>
        <artifactId>insight-digital</artifactId>
        <version>1.0.0</version>
        <!-- relativePath:告诉 Maven 父 POM 在上一级目录。
             为什么显式写:common 在根目录下一层,默认相对路径恰好就是 ../pom.xml,
             但企业规范要求显式声明,避免 Maven 去本地仓库找父 POM 的隐患 -->
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>insight-common</artifactId>
    <name>insight-common</name>
    <description>通用模块:统一响应体、全局异常、工具类(纯库 jar,没有 main 方法)</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- 日志门面:@Slf4j 要用(实现由各服务的 logback 提供) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Bean Validation 规范 API:统一处理参数校验异常 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- JWT:jjwt-api 编译期用,impl/jackson 运行期才需要 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 内部模块:复用 JwtUtil(common 只引 spring-web,不带 servlet 容器,WebFlux 兼容) -->
        <dependency>
            <groupId>com.insight</groupId>
            <artifactId>insight-common</artifactId>
        </dependency>
        <!-- 条件注解 @ConditionalOnProperty:让共享 Bean 按需注册(每个 Boot 应用本来就带它,不加新东西) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- MyBatis-Plus 三件套 + MySQL 驱动(和 user/inventory 一致) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Feign 两件套:2023 版 openfeign 不自带负载均衡器,缺 loadbalancer 启动即报错(购物车踩过的坑) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
    </dependencies>
</project>
