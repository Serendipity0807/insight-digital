<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.insight</groupId>
        <artifactId>insight-digital</artifactId>
        <version>1.0.0</version>
        <!-- relativePath:告诉 Maven 父 POM 在上一级目录。
             为什么显式写:common 在根目录下一层,默认相对路径恰好就是 ../pom.xml,
             但企业规范要求显式声明,避免 Maven 去本地仓库找父 POM 的隐患 -->
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>insight-common</artifactId>
    <name>insight-common</name>
    <description>通用模块:统一响应体、全局异常、工具类(纯库 jar,没有 main 方法)</description>

    <!-- 依赖在写第一个类(统一响应体 Result)时再加 -->
    <dependencies>
        <!-- Lombok:编译期生成 getter/setter/构造器;provided = 只编译期用,不打进包、不外泄 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
